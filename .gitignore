# NOTE: .gitignore does NOT support trailing inline comments — a '#' is only a comment at the
# START of a line. So every pattern below is on its own clean line.

# ── Claude Code / AI assistant local tooling ──
# CLAUDE.md is the private agent brief and stays out of the published repo.
# Everything under docs/ IS tracked and published: the user guides (install, first-run,
# configuration, troubleshooting, security, faq) and the design docs under docs/dev/.
.claude/
.claude.json
CLAUDE.local.md
**/CLAUDE.local.md
.cursor/
.aider*
CLAUDE.md

# ── Secrets & local state — NEVER publish ──
# config.yaml = live keys (ship release/config.sample.yaml); *.db = users/sessions;
# *.conf = WireGuard configs (private keys); vpnconfigs/ = uploaded VPN configs.
config.yaml
*.db
*.conf
vpnconfigs/

# ── Personal secrets / credentials (defensive patterns) ──
.env
.env.*
*.env
secrets/
*.secret
*credentials*
*.pem
*.key
*.crt
*.p12
*.kdbx
id_rsa*
id_ed25519*
*_rsa
askpass*
*.token

# ── Build artifacts ──
bin/
dist/
*.test
coverage.out

# ── Editor / OS noise ──
*.swp
*~
.DS_Store
.idea/
.vscode/
